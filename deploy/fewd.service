[Unit]
Description=fewd — family meal planner & cocktail manager
After=network.target
# Crash-loop cap: systemd allows 5 starts in a 300s window that opens at the
# first start, and refuses the 6th (Result: start-limit-hit), leaving the unit
# failed. With RestartSec=5 a panic on boot reaches that state in about 30s. A
# process that runs longer than 55s before each crash never trips the cap.
# Manual starts count toward the limit. Once it trips, systemd does not start
# the unit again on its own, and a manual start is refused until
# `systemctl reset-failed fewd` runs or that 300s window closes.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=fewd
Group=fewd
ExecStart=/opt/fewd/fewd-server
Environment="DATABASE_PATH=/opt/fewd/data/fewd.db"
Environment="PORT=3000"
# MCP_ALLOWED_HOSTS: comma-separated entries (mDNS/DNS names OR raw IP
# literals) matching the Host header that clients send when reaching /mcp.
# Replace `dietpi.local` with your deploy target's LAN address — that may
# be a hostname (`dietpi.local`, `homeserver`) or an IP (`192.168.1.42`) —
# before `just deploy`. Leave unset to allow only localhost. See README →
# MCP Server troubleshooting.
Environment="MCP_ALLOWED_HOSTS=dietpi.local"
# Without this, tracing_subscriber::fmt::init() defaults to ERROR-only and the
# server emits NO app/request logs — leaving the journal blank but for systemd's
# own lifecycle lines. `tower_http=debug` surfaces TraceLayer's per-request
# method/path/status/latency for /mcp and all routes. Drop to just `info` if the
# request logs get noisy on the low-RAM box.
Environment="RUST_LOG=info,tower_http=debug"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
