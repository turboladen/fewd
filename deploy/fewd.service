[Unit]
Description=fewd — family meal planner & cocktail manager
After=network.target

[Service]
Type=simple
User=fewd
Group=fewd
ExecStart=/opt/fewd/fewd-server
Environment="DATABASE_PATH=/opt/fewd/data/fewd.db"
Environment="PORT=3000"
# MCP_ALLOWED_HOSTS: comma-separated extra hostnames clients use to reach
# /mcp. Replace `dietpi.local` with your deploy target's LAN hostname before
# `just deploy` (this unit is copied verbatim to the target). Leave unset to
# only allow localhost. See README → MCP Server troubleshooting.
Environment="MCP_ALLOWED_HOSTS=dietpi.local"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
