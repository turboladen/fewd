{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "file=\"$TOOL_INPUT_file_path\"; case \"$file\" in *.ts|*.tsx|*.js|*.jsx|*.json) dprint fmt \"$file\" 2\u003e/dev/null;; */server/*.rs) cd server \u0026\u0026 cargo fmt 2\u003e/dev/null;; esac",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-protected-paths.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|MultiEdit|Write|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": ".claude/hooks/ci-before-push.sh",
            "timeout": 300,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
